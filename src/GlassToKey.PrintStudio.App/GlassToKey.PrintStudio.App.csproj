<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <RootNamespace>GlassToKey.PrintStudio.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0-browser'">$(DefineConstants);PRINT_STUDIO_BROWSER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GlassToKey.PrintStudio.Core/GlassToKey.PrintStudio.Core.csproj" />
    <ProjectReference Include="../GlassToKey.PrintStudio.Rendering/GlassToKey.PrintStudio.Rendering.csproj" Condition="'$(TargetFramework)' != 'net10.0-browser'" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>

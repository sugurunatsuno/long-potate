<Window
    x:Class="GlassToKey.PrintStudio.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GlassToKey.PrintStudio.App"
    xmlns:vm="using:GlassToKey.PrintStudio.App.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Title="{Binding Title}"
    Width="1280"
    Height="820"
    MinWidth="900"
    MinHeight="600">
  <local:MainView />
</Window>
